PORT=3001
# IANA, ej. America/Bogota (Colombia). Debe coincidir con el calendario local de la institución.
APP_TIMEZONE=America/Bogota
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Con migraciones, mantener false. No mezclar synchronize=true en producción.
TYPEORM_SYNC=false
JWT_SECRET=cambiar_por_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d
# CORS: abierto a cualquier origen (ver main.ts). FRONTEND_ORIGIN ya no se usa.

# UltraMsg (WhatsApp) — panel https://ultramsg.com → instancia → API Token
# La instancia debe estar CONECTADA (QR escaneado en WhatsApp).
ULTRAMSG_INSTANCE_ID=instanceXXXX
ULTRAMSG_TOKEN=
# Probar: npm run whatsapp:test -- 3001234567

# Recuperación de contraseña (código por WhatsApp)
PASSWORD_RESET_CODE_TTL_MINUTES=15

# Migraciones (desde la carpeta back):
# npm run migration:run
# npm run migration:revert
# npm run migration:show
